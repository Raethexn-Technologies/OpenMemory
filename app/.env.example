APP_NAME=OpenMemory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────
# Docker (PostgreSQL):
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=open_memory
DB_USERNAME=oma_user
DB_PASSWORD=secret

# Local dev without Docker (SQLite):
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ─── LLM — OpenRouter ─────────────────────────────────────────────
# OpenRouter proxies 400+ models under one API key: https://openrouter.ai/keys
#
# Model slugs (see https://openrouter.ai/models for full list):
#   Flagship:   anthropic/claude-sonnet-4.5  |  anthropic/claude-opus-4.5  |  google/gemini-2.5-pro
#   Fast/cheap: google/gemini-2.5-flash      |  google/gemini-2.5-flash-lite
#   Free:       google/gemini-2.5-flash:free |  meta-llama/llama-4-scout:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=OpenMemory

# Task-routed model selection. Leave blank to use OPENROUTER_MODEL for that task.
# classify/summarize fire often during ingest sweeps — cheap models pay back fast.
# reason is the heaviest cognitive task (graph extraction); spend on it sparingly.
LLM_MODEL_CLASSIFY=google/gemini-2.5-flash
LLM_MODEL_SUMMARIZE=google/gemini-2.5-flash
LLM_MODEL_REASON=
LLM_MODEL_CHAT=

# Redaction runs before memory content crosses LLM or storage boundaries.
# Presets: personal, professional, regulated. Floor categories (cards, bank
# details, government IDs, credentials, private keys) are always redacted.
REDACTION_ENABLED=true
REDACTION_PRESET=personal
# Optional separate HMAC key for deterministic redaction tokens. Defaults to APP_KEY.
REDACTION_HASH_KEY=

# ─── ICP Memory Layer ─────────────────────────────────────────────
# ICP_MOCK_MODE=true  → stores memories in file cache (no canister needed)
# ICP_MOCK_MODE=false → calls the Node adapter at ICP_CANISTER_ENDPOINT
#
# To run with a real canister:
#   1. cd icp && dfx start --background && dfx deploy
#   2. cd icp/adapter && npm install && ICP_MOCK=false node server.js
#   3. Set ICP_MOCK_MODE=false and ICP_CANISTER_ENDPOINT=http://localhost:3100
ICP_MOCK_MODE=true
ICP_CANISTER_ENDPOINT=http://localhost:3100
ICP_CANISTER_ID=
# ICP_BROWSER_HOST: the URL the *browser* uses to reach dfx or mainnet.
# Local default: http://localhost:4943  |  Mainnet: https://ic0.app
ICP_BROWSER_HOST=http://localhost:4943
# ICP_II_PROVIDER_URL: Internet Identity provider URL for the browser AuthClient.
# Leave empty to disable II login (mock mode still works; live ICP writes are blocked).
# Local dfx II: http://<II_CANISTER_ID>.localhost:4943 after `dfx deps deploy internet_identity`
# Mainnet II:   https://identity.ic0.app
ICP_II_PROVIDER_URL=

# ─── MCP Server (icp/mcp-server) ──────────────────────────────────
# Shared secret between the MCP server and this Laravel app.
# Generate with: openssl rand -hex 32
# Set this in icp/mcp-server env as OMA_API_KEY= (same value).
MCP_API_KEY=

# ─── Auto-ingest from connected sources ──────────────────────────
# The ingest pipeline fetches new artefacts (commits today; calendar,
# files later), redacts each, distils a single durable memory, then
# writes public items to the local graph. Mock mode also writes to ICP;
# live mode skips the canister write because /store on the adapter must
# be browser-signed. Non-public items are logged and dropped — the
# approval flow that exists for chat memories is not yet wired for
# ingest, so we refuse to publish anything without it.
#
# A PAT is optional for public repos (60 req/hour without it, 5000 with).
# Required for private repos. https://github.com/settings/tokens (read:repo)
GITHUB_INGEST_TOKEN=

# INGEST_GITHUB_REPOS: comma-separated owner/name slugs the sweep targets.
# In mock mode the UI button can override this per run; in live mode the
# override is rejected (the server's token would otherwise be a confused
# deputy for any session that knew a repo slug).
INGEST_GITHUB_REPOS=
INGEST_PER_REPO_LIMIT=20

# Background sweep: when true, php artisan schedule:run will call ingest:github
# every 20 minutes. Off by default — requires INGEST_USER_ID (the user_id to
# attribute memories to) and INGEST_GITHUB_REPOS to be set first.
INGEST_SCHEDULE_ENABLED=false
INGEST_USER_ID=

VITE_APP_NAME="${APP_NAME}"
